DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Set both values for password-reset emails; otherwise reset links print to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Identifica tu aplicación y un contacto real si usas Nominatim público.
GEOCODER_USER_AGENT=AgroFisica/0.1 (contacto: tu-correo@ejemplo.com)
# IA local opcional: instalar Ollama, iniciar `ollama serve` y ejecutar `ollama pull qwen3:4b`.
# No requiere clave. Solo se aceptan direcciones de loopback, nunca servicios externos.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
