DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Set both values for password-reset emails; otherwise reset links print to the server console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Identifica tu aplicación y un contacto real si usas Nominatim público.
GEOCODER_USER_AGENT=AgroFisica/0.1 (contacto: tu-correo@ejemplo.com)
# Opcional: proveedor compatible con OpenAI Chat Completions (HTTPS). Sin clave, la IA externa queda desactivada.
AGRO_AI_API_KEY=
AGRO_AI_MODEL=gpt-4o-mini
AGRO_AI_URL=https://api.openai.com/v1/chat/completions
